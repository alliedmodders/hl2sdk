import os


builder.SetBuildFolder('/')

project = builder.StaticLibraryProject('tier1')
project.sources = [
  'bitbuf.cpp',
  'byteswap.cpp',
  'characterset.cpp',
  'checksum_crc.cpp',
  'checksum_md5.cpp',
  'commandbuffer.cpp',
  'convar.cpp',
  'datamanager.cpp',
  'dbg.cpp',
  'diff.cpp',
  'generichash.cpp',
  'interface.cpp',
  'KeyValues.cpp',
  'mempool.cpp',
  'memstack.cpp',
  'NetAdr.cpp',
  'newbitbuf.cpp',
  'rangecheckedvar.cpp',
  'stringpool.cpp',
  'strtools.cpp',
  'tier1.cpp',
  'uniqueid.cpp',
  'utlbuffer.cpp',
  'utlbufferutil.cpp',
  'utlstring.cpp',
  'utlsymbol.cpp',
]

for cxx in HL2SDK.targets:
  binary = HL2SDK.ConfigureLibrary(project, cxx, builder)
  binary.compiler.defines += ['TIER1_STATIC_LIB']
  binary.compiler.cxxincludes += [
    builder.sourcePath,
    os.path.join(builder.sourcePath, 'common'),
    os.path.join(builder.sourcePath, 'public'),
    os.path.join(builder.sourcePath, 'public', 'tier0'),
    os.path.join(builder.sourcePath, 'public', 'tier1'),
  ]

HL2SDK.libs += builder.Add(project)
